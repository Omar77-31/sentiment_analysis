# ============ Django Settings ============
# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-50-char-random-string

# Defaults to False when unset. Set to True only for local development.
DEBUG=False

# Comma-separated list. Defaults to "localhost,127.0.0.1" when unset.
ALLOWED_HOSTS=localhost,127.0.0.1

# ============ PostgreSQL Database ============
DATABASE_NAME=sentiment_analysis_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============ AI Model ============
MODEL_NAME=CAMeL-Lab/bert-base-arabic-camelbert-da-sentiment